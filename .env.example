# --- Lead delivery (set at least one for external beta) ---
# Zapier / Make / Slack / CRM webhook that accepts JSON POST
LEAD_WEBHOOK_URL=

# Neon (or other Postgres) connection string — stores leads + auth tables
# Production (Vercel): optional if LEAD_WEBHOOK_URL is set. Without DATABASE_URL,
# PGLite is NOT used on Vercel (it crashes serverless). Calculator + webhook leads still work.
# Production note: never rely on PGLite on Vercel.
DATABASE_URL=

# Mailto fallback when online delivery is offline (public, safe for VITE_)
VITE_LEAD_FALLBACK_EMAIL=agents@psmbrokerage.com

# Canonical public URL (HubSpot page or Vercel domain)
VITE_PUBLIC_SITE_URL=https://www.psmbrokerage.com/insurance-agent-opportunity-calculator

# Optional: exact calculator host if different from Vercel project name
# VITE_PUBLIC_APP_URL=https://psm-agent-opportunity-calculator.vercel.app

# Extra browser Origins allowed to POST leads (comma-separated hosts or full origins)
# Defaults already include *.vercel.app, psmbrokerage.com, localhost
# LEAD_ALLOWED_ORIGINS=https://calculator.psmbrokerage.com

# --- Auth (optional — calculator is public) ---
VITE_AUTH_ENABLED=false
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=
GROK_AUTH_ISSUER=
