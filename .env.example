# --- Auth (optional — calculator is public) ---
VITE_AUTH_ENABLED=false
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=
